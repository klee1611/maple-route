# Sanity
SANITY_POLICY_MCP_URL=            # https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<name>
SANITY_EMPLOYER_MCP_URL=          # Phase E
SANITY_READ_TOKEN=                # org token with Context Viewer
SANITY_WRITE_TOKEN=               # import script only, never deployed
SANITY_PROJECT_ID=
SANITY_DATASET=
# Optional: streamable_http (default) or sse
SANITY_MCP_TRANSPORT=streamable_http

# LLM (Groq)
GROQ_API_KEY=
# Free tier is 8K tokens/min PER MODEL, so agents are spread by input size (measured on
# the real KB): entry extraction (largest) has gpt-oss-120b to itself; synthesizer and
# verifier share gpt-oss-20b; qwen runs the two small steps. qwen produced malformed JSON
# on larger schemas in testing, and only gpt-oss supports strict structured outputs.
MODEL_ORCHESTRATOR=qwen/qwen3.8-27b
MODEL_POLICY_SELECT=qwen/qwen3.8-27b
MODEL_POLICY=openai/gpt-oss-120b
MODEL_EMPLOYER=openai/gpt-oss-20b
MODEL_SYNTHESIZER=openai/gpt-oss-20b
MODEL_VERIFIER=openai/gpt-oss-20b
REASONING_EFFORT=low          # gpt-oss only: low | medium | high

# Limits and cache (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_ANSWER_LIMIT=30
PER_IP_HOURLY_LIMIT=5
CACHE_TTL_HOURS=12

# Bot protection (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Tracing (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=maple-route
